	column hospital_size = ```
			SWITCH(TRUE(), 
			complete_hcahps_data[number_beds] >= 500, "large",
			complete_hcahps_data[number_beds] >= 100 && complete_hcahps_data[number_beds] <500, "medium",
			"small")
			```
		dataType: string
		lineageTag: 06ef7c9b-a7b5-4267-86eb-039aae57356d
		summarizeBy: none

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	column unique_facility_name = CONCATENATE(CONCATENATE(complete_hcahps_data[provider_ccn], "-"), complete_hcahps_data[facility_name])
